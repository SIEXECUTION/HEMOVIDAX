# Backend Django / Render: la base Supabase ya contiene el schema.
DEBUG=True
SECRET_KEY=
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Solo para una base de desarrollo creada explícitamente. Nunca en Render.
USE_SQLITE=False
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HemoVida <seguridad@example.com>
# Alternativa HTTP al SMTP si el proveedor de despliegue restringe sus puertos.
BREVO_API_KEY=
